{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/cli.ts",
    "src/cli/**/*.ts",
    "src/core/**/*.ts",
    "src/providers/**/*.ts",
    "src/services/**/*.ts"
  ]
}
